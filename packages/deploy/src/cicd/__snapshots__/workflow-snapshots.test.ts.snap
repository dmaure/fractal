            echo "Current image: $CURRENT_IMAGE"
            
            # Actualizar compose con nueva imagen
            export IMAGE_TAG=$IMAGE_TAG
            docker compose pull
            docker compose up -d --no-build
            
            # Esperar que los contenedores estén listos
