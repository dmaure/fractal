              if [ -n "$PREVIOUS_TAG" ]; then
                export IMAGE_TAG=$PREVIOUS_TAG
                docker compose up -d
                echo "Rolled back to $PREVIOUS_TAG"
              fi
            fi
            
            exit 1
ENDSSH
          
          rm -f deploy_key

      - name: Notify deployment status
        if: always()
        run: |
          if [ \${{ job.status }} == 'success' ]; then
            echo "✓ Deploy exitoso a https://app.example.com"
