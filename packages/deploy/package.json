{
  "name": "@fractal/deploy",
  "version": "0.0.0",
  "description": "Provisioning, Docker, Nginx, SSL, CI/CD. Framework-agnostic.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "vitest run --typecheck.enabled",
    "test:watch": "vitest --typecheck.enabled",
    "test:typecheck": "vitest --typecheck.only --run"
  },
  "dependencies": {
    "ssh2": "^1.16.0"
  },
  "devDependencies": {
    "@fractal/core": "workspace:*",
    "@types/node": "^22.0.0",
    "@types/ssh2": "^1.15.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0",
    "yaml": "^2.9.1"
  },
  "keywords": [
    "fractal",
    "deploy",
    "provisioning",
    "docker"
  ],
  "author": "Fractal",
  "license": "MIT"
}
