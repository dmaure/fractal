  "demo/docker/nginx/certbot/.gitkeep": "",
  "demo/docker/nginx/nginx.conf": "# nginx.conf generado por Fractal
# Sirve la app Laravel por HTTP (puerto 80, redirect a HTTPS) y HTTPS (puerto
# 443, TLS terminado en el contenedor), y delega PHP al contenedor php-fpm.
worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    sendfile on;
    keepalive_timeout 65;
    client_max_body_size 100M;

    server {
        listen 80;
        listen [::]:80;
        server_name _;

        # Challenge ACME HTTP-01 (Let's Encrypt): webroot compartido con el host.
        location /.well-known/acme-challenge/ {
            root /var/www/certbot;
        }

        # Todo lo demás se redirige a HTTPS.
        location / {
            return 301 https://$host$request_uri;
        }
    }

    server {
        listen 443 ssl;
        listen [::]:443 ssl;
        http2 on;
        server_name _;

        ssl_certificate /etc/nginx/ssl/fullchain.pem;
        ssl_certificate_key /etc/nginx/ssl/privkey.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_ciphers HIGH:!aNULL:!MD5;
        ssl_prefer_server_ciphers on;

        root /var/www/html/public;
        index index.php index.html;

        charset utf-8;

        # API: Laravel (php-fpm).
        location /api/ {
            try_files $uri /index.php?$query_string;
        }

        # Sin frontend: todo lo que no es estático lo resuelve Laravel.
        location / {
            try_files $uri /index.php?$query_string;
        }

        location = /favicon.ico { access_log off; log_not_found off; }
        location = /robots.txt  { access_log off; log_not_found off; }

        error_page 404 /index.php;

        location ~ \\.php$ {
            fastcgi_pass app:9000;
            fastcgi_index index.php;
            include fastcgi_params;
            fastcgi_param SCRIPT_FILENAME $realpath_root$fastcgi_script_name;
            fastcgi_param DOCUMENT_ROOT $realpath_root;
        }

        location ~ /\\.(?!well-known).* {
            deny all;
        }
    }
}
",
