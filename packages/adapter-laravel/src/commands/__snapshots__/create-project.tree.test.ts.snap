  "demo/Dockerfile": "# Dockerfile generado por Fractal
# imagen php-fpm para producción. Se construye en el VPS durante el deploy.
FROM php:8.3-fpm

# Dependencias de sistema y extensiones PHP requeridas por Laravel + PostgreSQL.
RUN apt-get update && apt-get install -y --no-install-recommends \\
        git \\
        unzip \\
        libpq-dev \\
        libzip-dev \\
        libicu-dev \\
    && docker-php-ext-install pdo pdo_pgsql pgsql zip intl opcache bcmath \\
    && apt-get clean \\
    && rm -rf /var/lib/apt/lists/*

# Composer (copiado desde la imagen oficial).
COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

# Copiar el código de la aplicación.
COPY . /var/www/html


# Instalar dependencias de producción.
RUN composer install --no-dev --optimize-autoloader --no-interaction --no-progress

# Permisos de escritura para el runtime de Laravel.
RUN chown -R www-data:www-data storage bootstrap/cache \\
    && chmod -R ug+rwX storage bootstrap/cache

# php-fpm, por default, vacía el entorno del worker (\`clear_env = yes\`).
# Las variables que compose inyecta (APP_KEY, DB_*, APP_URL) no llegarían
# a PHP y Laravel respondería 500 en \`/\` (EncryptCookies exige APP_KEY).
# Destapado por el e2e real de FRA-73: HTTPS devolvía 500 estable.
RUN printf '%s\\n' '[www]' 'clear_env = no' \\
    > /usr/local/etc/php-fpm.d/zz-fractal.conf

EXPOSE 9000

CMD ["php-fpm"]
",
  "demo/README.md": "# demo

Proyecto Laravel en topología monolito, generado por Fractal.

## Instalación

\`\`\`bash
composer install
cp .env.example .env
php artisan key:generate
\`\`\`

## Desarrollo

\`\`\`bash
php artisan serve
(cd web && npm install && npm run dev)
\`\`\`

- API (Laravel): http://localhost:8000
- SPA (Vite, con proxy de /api a Laravel): http://localhost:3000

## Build

\`\`\`bash
(cd web && npm run build)
\`\`\`

## Tests

\`\`\`bash
php artisan test
\`\`\`


## Deploy

Este proyecto está configurado para desplegarse con \`fractal deploy\`.

## Documentación

- [Fractal](https://github.com/dmaure/fractal)
- [Laravel](https://laravel.com/docs)
",
  "demo/app/Http/Controllers/Api/HealthController.php": "<?php

namespace App\\Http\\Controllers\\Api;

use Illuminate\\Http\\JsonResponse;

class HealthController
{
    public function check(): JsonResponse
    {
        return response()->json([
            'status' => 'healthy',
            'timestamp' => now()->toIso8601String(),
        ]);
    }
}
",
