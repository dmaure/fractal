{
  "name": "@fractal/adapter-laravel",
  "version": "0.0.0",
  "description": "Adapter para Laravel: stubs y lógica PHP específica",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "fractal-adapter-laravel": "./dist/bridge-entry.js"
  },
  "fractal": {
    "adapter": true,
    "target": "laravel",
    "bridge": "dist/bridge-entry.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fractal/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "fractal",
    "adapter",
    "laravel",
    "php"
  ],
  "author": "Fractal",
  "license": "MIT"
}
