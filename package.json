{
  "name": "@fractal/monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Generador de aplicaciones production-ready, multi-framework",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "postinstall": "node scripts/install-cli.js",
    "cli:install": "node scripts/install-cli.js",
    "cli:uninstall": "node scripts/install-cli.js --uninstall",
    "test": "pnpm -r test && vitest run --config vitest.scripts.config.ts",
    "test:scripts": "vitest run --config vitest.scripts.config.ts",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint && node scripts/lint-coupling.js",
    "lint:coupling": "node scripts/lint-coupling.js",
    "progress": "pnpm --filter @fractal/core build && node scripts/progress-map.js",
    "status": "pnpm --filter \"@fractal/core...\" build && node packages/core/dist/cli.js status",
    "status:check": "pnpm -r build && node packages/core/dist/cli.js status --check"
  },
  "keywords": [
    "fractal",
    "generator",
    "multi-framework"
  ],
  "author": "Fractal",
  "license": "MIT",
  "devDependencies": {
    "@fractal/core": "workspace:*",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
